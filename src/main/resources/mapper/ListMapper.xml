<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.practice.board.ListMapper">

    <select id="selectAll" resultType="com.example.practice.board.BoardListDto">
        SELECT category,title,writer,created_at FROM board_table
        ORDER BY created_at DESC
    </select>
</mapper>
