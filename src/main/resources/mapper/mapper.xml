<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.practice.board.InsertMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="boardId">
        INSERT INTO board_table (writer, category, title, content)
        VALUES (#{writer}, #{category}, #{title}, #{content})
    </insert>
</mapper>